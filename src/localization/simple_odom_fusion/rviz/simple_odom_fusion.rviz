Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
      Value: true
    - Class: rviz/Odometry
      Color: 255; 80; 80
      Enabled: true
      Keep: 500
      Name: DR
      Topic: /localization/dr_odom
      Value: true
    - Class: rviz/Odometry
      Color: 80; 160; 255
      Enabled: true
      Keep: 500
      Name: SLAM
      Topic: /localization/slam_odom
      Value: true
    - Class: rviz/Odometry
      Color: 40; 220; 120
      Enabled: true
      Keep: 1000
      Name: Simple Fused
      Topic: /localization/simple_fused_odom
      Value: true
    - Class: rviz/Path
      Color: 40; 220; 120
      Enabled: true
      Name: Simple Fused Path
      Topic: /localization/simple_fused_path
      Value: true
    - Class: rviz/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: GM Source Odom Cloud
      Size (m): 0.05
      Topic: /localization/simple_fusion/gm_source_cloud_odom
      Value: true
    - Class: rviz/PointCloud2
      Color Transformer: FlatColor
      Color: 120; 120; 120
      Enabled: true
      Name: Global Matcher Map
      Size (m): 0.08
      Topic: /localization/global_matcher/global_map
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 80
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785
      Target Frame: map
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
