<?xml version="1.0"?>
<package format="2">
  <name>slam_odometry_v2</name>
  <version>0.1.0</version>
  <description>
    slam_odometry_v2: 基于 faster_lio_ws 原始算法的纯里程计节点。
    算法源码（IKFoM / iVox / imu_processing / pointcloud_preprocess 等）
    全部移植自 faster_lio_ws，独立成包，-O3 优化编译运行，
    输入输出与 slam_odometry 当前外接形式（fastlio2）对齐。
    建图部分拆分至 slam_mapping_v2（关键帧 / GNSS 优化 / 回环）。
  </description>
  <maintainer email="deeplumin@example.com">DeepLumin Team</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>message_generation</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen_conversions</depend>
  <depend>message_runtime</depend>
  <depend>deeplumin_msgs</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libyaml-cpp-dev</depend>
  <depend>libpcl-dev</depend>
  <depend>libeigen3-dev</depend>
  <depend>deeplumin_health_checker</depend>

  <export>
  </export>
</package>
