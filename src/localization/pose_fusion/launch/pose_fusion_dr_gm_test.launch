<launch>
  <!--
    DR + Global Matcher + Pose Fusion online test.

    Pipeline:
      bag sensors -> sensor_frame_adapter + dr_odometry
      /localization/points + /localization/fused_odom -> global_matcher
      /localization/dr_odom + /localization/global_matcher/result -> pose_fusion

    This launch intentionally does not start slam_odometry or localization_manager,
    so pose_fusion uses its default observer policy and GM/DR behavior can be inspected directly.
  -->
  <arg name="dr_config" default="$(find dr_odometry)/config/dr_odometry.yaml" />
  <arg name="global_matcher_config" default="$(find global_matcher)/config/global_matcher.yaml" />
  <arg name="pose_fusion_config" default="$(find pose_fusion)/config/pose_fusion.yaml" />
  <arg name="adapter_config" default="$(find sensor_frame_adapter)/config/sensor_frame_adapter.yaml" />
  <arg name="pcd_path" default="/home/hhy/2004ros/relocalization_ws/global_map_manual_imu.pcd" />

  <arg name="bag" default="/home/hhy/2004ros/data/2026-07-14-11-17-21.bag" />
  <arg name="play_bag" default="true" />
  <arg name="bag_rate" default="1.0" />
  <arg name="bag_delay" default="2.0" />
  <arg name="clock" default="true" />
  <arg name="rviz" default="true" />
  <arg name="path_compare" default="true" />
  <arg name="debug_cold_start" default="false" />

  <param name="/use_sim_time" value="$(arg clock)" />

  <node pkg="sensor_frame_adapter" type="sensor_frame_adapter_node" name="sensor_frame_adapter" output="screen">
    <rosparam file="$(arg adapter_config)" command="load" />
  </node>

  <node pkg="dr_odometry" type="dr_odometry_node" name="dr_odometry" output="screen">
    <rosparam file="$(arg dr_config)" command="load" />
    <!-- pose_fusion owns the final TF chain in this test. -->
    <param name="dr/publish_tf" value="false" />
  </node>

  <node pkg="pose_fusion" type="pose_fusion_node" name="pose_fusion" output="screen">
    <rosparam file="$(arg pose_fusion_config)" command="load" />
    <param name="runtime/publish_tf" value="true" />
    <param name="runtime/publish_map_to_odom_tf" value="true" />
    <param name="runtime/publish_odom_to_base_tf" value="true" />

    <!-- No manager in this launch. GM can initialize fusion; /initialpose remains available for manual reset. -->
    <param name="topics/initial_pose" value="/initialpose" />
    <param name="initialization/operation_mode" value="debug_dr_gm" />
    <param name="initialization/allow_dr_initialization" value="$(arg debug_cold_start)" />
    <param name="initialization/allow_slam_initialization" value="false" />
    <param name="initialization/allow_global_matcher_initialization" value="true" />

    <!-- Single-local-odometry test: only DR and GM should affect fusion. -->
    <param name="observers/slam/enabled" value="false" />
    <param name="observers/global_matcher/enabled" value="true" />
  </node>

  <node pkg="global_matcher" type="global_matcher_node" name="global_matcher" output="screen">
    <rosparam file="$(arg global_matcher_config)" command="load" />
    <param name="map/pcd_path" value="$(arg pcd_path)" />
    <param name="topics/source_cloud" value="/localization/points" />
    <param name="topics/initial_pose" value="/localization/fused_odom" />
    <param name="topics/source_odom" value="/localization/dr_odom" />
    <param name="topics/bootstrap_initial_pose" value="/initialpose" />
    <param name="topics/result" value="/localization/global_matcher/result" />
    <param name="runtime/source_cloud_is_odom_frame" value="false" />
    <param name="runtime/source_cloud_frame" value="lidar" />
  </node>

  <node if="$(arg path_compare)" pkg="pose_fusion" type="pose_fusion_path_compare_node"
        name="pose_fusion_dr_gm_path_compare" output="screen">
    <param name="map_frame" value="map" />
    <param name="enable_dr" value="true" />
    <param name="enable_slam" value="false" />
    <param name="enable_fused" value="true" />
    <param name="topics/dr_odom" value="/localization/dr_odom" />
    <param name="topics/slam_odom" value="/localization/slam_odom" />
    <param name="topics/fused_odom" value="/localization/fused_odom" />
    <param name="topics/dr_path_map" value="/localization/compare/dr_path_map" />
    <param name="topics/slam_path_map" value="/localization/compare/slam_path_map" />
    <param name="topics/fused_path_map" value="/localization/compare/fused_path_map" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="pose_fusion_dr_gm_test_rviz"
        args="-d $(find pose_fusion)/rviz/pose_fusion_online_test.rviz" />

  <node if="$(arg play_bag)" pkg="rosbag" type="play" name="pose_fusion_dr_gm_test_bag"
        args="--clock --delay=$(arg bag_delay) -r $(arg bag_rate) $(arg bag)" output="screen" />
</launch>
