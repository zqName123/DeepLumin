<?xml version="1.0"?>
<package format="2">
  <name>mapping_gui</name>
  <version>1.0.0</version>
  <description>GUI workbench for DeepLumin mapping control and monitoring</description>
  <maintainer email="developer@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>deeplumin_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>deeplumin_msgs</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
