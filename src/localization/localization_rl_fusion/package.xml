<?xml version="1.0"?>
<package format="2">
  <name>localization_rl_fusion</name>
  <version>0.1.0</version>
  <description>Lightweight robot_localization based fusion and visualization for DeepLumin localization sources.</description>
  <maintainer email="developer@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>pcl_conversions</build_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
