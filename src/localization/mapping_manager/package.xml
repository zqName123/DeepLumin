<?xml version="1.0"?>
<package format="2">
  <name>mapping_manager</name>
  <version>1.0.0</version>
  <description>Task orchestrator for DeepLumin mapping workflow</description>
  <maintainer email="developer@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>deeplumin_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>deeplumin_msgs</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
