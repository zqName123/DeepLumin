<launch>
  <arg name="config" default="$(find slam_mapping)/config/slam_mapping.yaml" />
  <arg name="auto_start" default="true" />

  <node pkg="slam_mapping" type="slam_mapping_node" name="slam_mapping" output="screen">
    <rosparam file="$(arg config)" command="load" />
    <param name="mapping/auto_start" value="$(arg auto_start)" />
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find slam_mapping)/rviz/hhy.rviz" output="screen" />
</launch>
